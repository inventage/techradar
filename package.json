{
  "name": "techradar",
  "version": "1.0.0",
  "scripts": {
    "start": "run-p watch_build serve",
    "build": "node scripts/techradar.mjs build",
    "serve": "node scripts/techradar.mjs serve",
    "watch_build": "npm-watch build"
  },
  "watch": {
    "build": {
      "patterns": [
        "radar/**"
      ],
      "extensions": "md"
    }
  },
  "devDependencies": {
    "aoe_technology_radar": "4.6.1",
    "csv-parser": "^3.0.0",
    "http-server": "^14.1.1",
    "npm-run-all": "4.1.5",
    "npm-watch": "0.11.0",
    "replace-in-file": "^6.3.5",
    "tsx": "^4.21.0",
    "write": "^2.0.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.11",
    "marked-highlight": "^2.2.3"
  }
}
